<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>OutilsTs</RootNamespace>
    <AssemblyName>OutilsTs</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <PackageId>OutilsTs</PackageId>
    <Version>2.0.3</Version> <!-- Incrémenter ici : 1.0.0 → 1.0.1 → 1.1.0 etc. -->
    <Authors>NorinRad39</Authors>
    <Company>Votre Société</Company>
    <Description>Classe utilitaire pour TopSolid Automating - Export, connexion et outils</Description>
    <PackageProjectUrl>https://github.com/NorinRad39/Classe-outils-topsolid</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NorinRad39/Classe-outils-topsolid</RepositoryUrl>
    <PackageTags>topsolid;automating;export;cad</PackageTags>
    <PackageReleaseNotes>RUPTURE : la classe ProjetPDM est supprimee ; ses fonctionnalites sont reprises par PDM. Ajouts : bibliotheques PDM (GetLibraries, GetLibraryNames, GetLibraryByName, TryGetLibrary, RefLibrary), parcours de projet (GetAllProjectDocuments, GetProjectFolders), etat des documents (IsCheckedIn, IsValidated, IsInRecycleBin) et recuperation des publications. Correction : generation du chemin d'export lorsque le dossier Ind n'existe pas.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Platforms>x64</Platforms>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <!-- Force le nom du fichier XML de documentation pour éviter un nom vide (.xml) -->
      <DocumentationFile>bin\$(Configuration)\$(AssemblyName).xml</DocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Optimize>True</Optimize>
  </PropertyGroup>
	
	<PropertyGroup>
      <CharSet>Unicode</CharSet>
    </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net481" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="TopSolid.Cad.Design.Automating" Version="7.20.400.121" />
    <PackageReference Include="TopSolid.Cad.Drafting.Automating" Version="7.20.400.121" />
    <PackageReference Include="TopSolid.Cad.Electrode.Automating" Version="7.20.400.121" />
    <PackageReference Include="TopSolid.Cam.NC.Kernel.Automating" Version="7.20.400.121" />
    <PackageReference Include="TopSolid.Kernel.Automating" Version="7.20.400.121" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="FodyWeavers.xml" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>